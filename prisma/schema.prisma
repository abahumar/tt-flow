generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String     @id @default(cuid())
  url         String     @unique
  title       String
  description String     @default("")
  images      String     @default("[]") // JSON array of image URLs
  price       String     @default("")
  shopName    String     @default("")
  videoReady  Boolean    @default(false) // marked for video creation
  scrapedAt   DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  videoJobs   VideoJob[]
}

model VideoJob {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  status        String   @default("pending") // pending, generating_image, generating_video, ready, posting, posted, failed
  videoType     String   @default("fungsi_produk") // marketing angle
  imagePrompt   String   @default("")
  videoPrompt   String   @default("")
  imageUrl      String   @default("")
  videoUrl      String   @default("")
  tiktokCaption       String   @default("")
  tiktokHashtags      String   @default("[]") // JSON array of hashtag strings
  tiktokProductName   String   @default("") // Clean product name for TikTok product link (max 30 chars)
  tiktokDescription   String   @default("") // Product description with hashtags for TikTok product link
  tiktokPostUrl       String   @default("")
  errorMessage  String   @default("")
  retryCount    Int      @default(0) // how many times this job has been retried
  maxRetries    Int      @default(3) // max auto-retry attempts before giving up
  lastError     String   @default("") // category: retryable|fatal|timeout
  startedAt     DateTime? // when the job started processing (for timeout detection)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ScrapeRequest {
  id        String   @id @default(cuid())
  url       String
  status    String   @default("pending") // pending, scraping, done, failed
  error     String   @default("")
  productId String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomPrompt {
  id          String   @id @default(cuid())
  name        String
  imagePrompt String   @default("")
  videoPrompt String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryVideo {
  id        String   @id @default(cuid())
  filename  String   // e.g. "abc123.mp4" — the file in /data/videos/
  videoType String   @default("")
  caption   String   @default("")
  createdAt DateTime @default(now())
}
