generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id             String     @id @default(cuid())
  url            String     @unique
  title          String
  description    String     @default("")
  images         String     @default("[]") // JSON array of image URLs
  price          String     @default("")
  shopName       String     @default("")
  usp            String     @default("") // Unique Selling Proposition — key benefits/features
  targetAudience String     @default("") // Target audience description
  videoReady     Boolean    @default(false) // marked for video creation
  scrapedAt      DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  videoJobs      VideoJob[]
}

model VideoJob {
  id            String   @id @default(cuid())
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  status        String   @default("pending") // pending, generating_image, generating_video, ready, posting, posted, failed
  videoType     String   @default("fungsi_produk") // marketing angle
  imageOnly     Boolean  @default(false) // true = stop after image generation (no video/posting)
  referenceImage String  @default("") // uploaded reference image filename for image-only jobs
  referenceImages String @default("[]") // JSON array of reference image filenames (background, model, etc)
  imagePrompt   String   @default("")
  videoPrompt   String   @default("")
  imageUrl      String   @default("")
  videoUrl      String   @default("")
  tiktokCaption       String   @default("")
  tiktokHashtags      String   @default("[]") // JSON array of hashtag strings
  tiktokProductName   String   @default("") // Clean product name for TikTok product link (max 30 chars)
  tiktokDescription   String   @default("") // Product description with hashtags for TikTok product link
  tiktokPostUrl       String   @default("")
  errorMessage  String   @default("")
  retryCount    Int      @default(0) // how many times this job has been retried
  maxRetries    Int      @default(3) // max auto-retry attempts before giving up
  lastError     String   @default("") // category: retryable|fatal|timeout
  templateId    String   @default("") // links to VideoTemplate for consistent mode
  groupId       String   @default("") // groups scenes from same Video Studio generation
  sceneIndex    Int      @default(0)  // scene order: 0 = master scene, 1, 2, 3...
  masterJobId   String   @default("") // job ID of scene 0 (whose image is the master reference)
  scenePrompts  String   @default("") // JSON array of {imagePrompt, videoPrompt} for multi-scene jobs
  combinedVideoUrl String @default("") // URL of final combined multi-scene video
  overlayConfig String   @default("") // JSON: {hookTitle, hookSubtitle, overlays: [{text, position}]}
  startedAt     DateTime? // when the job started processing (for timeout detection)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ScrapeRequest {
  id        String   @id @default(cuid())
  url       String
  status    String   @default("pending") // pending, scraping, done, failed
  error     String   @default("")
  productId String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomPrompt {
  id          String   @id @default(cuid())
  name        String
  imagePrompt String   @default("")
  videoPrompt String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryVideo {
  id        String   @id @default(cuid())
  filename  String   // e.g. "abc123.mp4" — the file in /data/videos/
  videoType String   @default("")
  caption   String   @default("")
  createdAt DateTime @default(now())
}

model ImageJob {
  id              String    @id @default(cuid())
  status          String    @default("pending") // pending, generating, completed, failed
  imagePrompt     String    @default("")
  referenceImage  String    @default("") // filename in /data/images/references/
  resultImage     String    @default("") // filename in /data/images/generated/
  errorMessage    String    @default("")
  retryCount      Int       @default(0)
  maxRetries      Int       @default(3)
  lastError       String    @default("") // retryable|fatal|timeout
  startedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  filename  String   // e.g. "abc123.png" — the file in /data/images/generated/
  prompt    String   @default("")
  createdAt DateTime @default(now())
}

model VideoTemplate {
  id               String   @id @default(cuid())
  name             String
  backgroundImage  String   @default("") // filename in /data/images/references/
  backgroundDesc   String   @default("") // text description of the background
  modelImage       String   @default("") // filename in /data/images/references/
  modelDesc        String   @default("") // text description of the model/avatar
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
